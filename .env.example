# Non-secret application configuration
DEPLOYMENT_ENVIRONMENT=ibm-mq-lab
OTEL_SDK_DISABLED=false

# IBM MQ connection (developer image defaults)
MQ_QUEUE_MANAGER=QM1
MQ_CONN_NAME=mq(1414)
MQ_CHANNEL=DEV.APP.SVRCONN
MQ_USER=app
MQ_APP_PASSWORD=passw0rd
MQ_ADMIN_PASSWORD=passw0rd
MQ_REQUEST_QUEUE=ORDER.REQ
MQ_RESPONSE_QUEUE=ORDER.RESP

# Producer HTTP port (host mapping)
PRODUCER_PORT=8080
